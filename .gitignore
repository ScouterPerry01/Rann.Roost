# File Description: Files and folders git never tracks.
# Uses: N/A
# Used By: git.
# Purpose: Keep build output, personal settings, household data and private papers out of the repository.

# Gradle / build
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar
.kotlin/
local.properties

# IDE
.idea/
*.iml
.vscode/
out/

# OS
.DS_Store
Thumbs.db

# Spike artefacts
spikes/**/models/
spikes/**/bin/
spikes/**/obj/

# Claude Code: agent worktrees and personal settings
.claude/worktrees/
.claude/settings.local.json

# Never commit household data or keys
*.hfm/
*.hfmbak

# Microsoft Store certification reports (private, kept beside the project only)
docs/MS.Cert.Issue/
