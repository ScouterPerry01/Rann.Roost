-- Modified On Timestamp: 2026-10-26 @ 04:01 EDT
-- Created On Timestamp: 2026-10-02 @ 18:29 EDT
-- File Description: Ledger tables and queries. Crypto-asset wallets (CR-01 to CR-06). A wallet is a CRYPTO_WALLET account held in its coin.
-- Uses: SQLDelight; the ledger migrations (<n>.sqm) create the same tables.
-- Used By: core/books services, through LedgerDatabase.
-- Purpose: Part of each account group's encrypted ledger database (HH-11).

-- Crypto-asset wallets (CR-01 to CR-06). A wallet is a CRYPTO_WALLET account held in its coin.

-- What the books need beyond the account: the cost (in the base currency) of the coins already in
-- the wallet when its history starts, and for a watch-only wallet (CR-02) the public address or
-- extended public key it follows. Private keys and seed phrases are never stored.
CREATE TABLE wallet (
    account_id TEXT NOT NULL PRIMARY KEY REFERENCES account(id) ON DELETE CASCADE,
    opening_cost_minor INTEGER,
    watch TEXT,
    watch_kind TEXT CHECK (watch_kind IN ('ADDRESS', 'XPUB')),
    last_sync INTEGER,
    notes TEXT
);

upsertWallet:
INSERT INTO wallet(account_id, opening_cost_minor, watch, watch_kind, last_sync, notes) VALUES (?, ?, ?, ?, ?, ?)
ON CONFLICT(account_id) DO UPDATE SET opening_cost_minor = excluded.opening_cost_minor, watch = excluded.watch, watch_kind = excluded.watch_kind, last_sync = excluded.last_sync, notes = excluded.notes;

wallet:
SELECT * FROM wallet WHERE account_id = ?;

setWalletSynced:
UPDATE wallet SET last_sync = ? WHERE account_id = ?;
