-- File path and name: core/data/src/main/sqldelight/ledger/ca/schippers/hfm/data/ledger/Loans.sq
-- Modified On Timestamp: 2026-10-26 @ 04:01 EDT
-- Created On Timestamp: 2026-10-02 @ 11:38 EDT
-- File Description: Ledger tables and queries. Loans and mortgages (LN-01 to LN-06).
-- Uses: SQLDelight; the ledger migrations (<n>.sqm) create the same tables.
-- Used By: core/books services, through LedgerDatabase.
-- Purpose: Part of each account group's encrypted ledger database (HH-11).

-- Loans and mortgages (LN-01 to LN-06). Amounts are in the loan account's currency, in minor units;
-- rates are annual fractions as decimal strings.

-- LN-01: the terms as agreed, or as they stood at the start of the current term. payment_minor is
-- the lender's payment when known (otherwise it is calculated); property tax and insurance are
-- collected with each payment (LN-05).
CREATE TABLE loan (
    account_id TEXT NOT NULL PRIMARY KEY REFERENCES account(id) ON DELETE CASCADE,
    principal_minor INTEGER NOT NULL,
    annual_rate TEXT NOT NULL,
    rate_type TEXT NOT NULL DEFAULT 'FIXED' CHECK (rate_type IN ('FIXED', 'VARIABLE')),
    compounding TEXT NOT NULL CHECK (compounding IN ('ANNUAL', 'SEMI_ANNUAL', 'MONTHLY')),
    amortization_months INTEGER NOT NULL,
    frequency TEXT NOT NULL CHECK (frequency IN ('MONTHLY', 'SEMI_MONTHLY', 'BI_WEEKLY', 'ACCELERATED_BI_WEEKLY', 'WEEKLY', 'ACCELERATED_WEEKLY')),
    first_payment_date TEXT NOT NULL,
    payment_minor INTEGER,
    extra_payment_minor INTEGER,
    -- LN-04: end of the current term, and how many days before it to remind.
    term_end TEXT,
    renewal_remind_days INTEGER NOT NULL DEFAULT 120,
    property_tax_minor INTEGER,
    insurance_minor INTEGER,
    -- The account payments come from, and the date of the last payment recorded.
    payment_account_id TEXT,
    last_paid_date TEXT,
    notes TEXT
);

-- LN-03: lump sums, rate changes (renewals, variable rates) and payment changes.
CREATE TABLE loan_change (
    id TEXT NOT NULL PRIMARY KEY,
    account_id TEXT NOT NULL REFERENCES account(id) ON DELETE CASCADE,
    date TEXT NOT NULL,
    kind TEXT NOT NULL CHECK (kind IN ('PREPAYMENT', 'RATE_CHANGE', 'PAYMENT_CHANGE')),
    amount_minor INTEGER,
    annual_rate TEXT,
    recalculate INTEGER NOT NULL DEFAULT 0,
    txn_id TEXT,
    notes TEXT,
    created_at INTEGER NOT NULL,
    -- M-30 (version 26): a renewal is a rate change that also moved the term end; it keeps the
    -- term end it replaced, so deleting it puts that back.
    renewal INTEGER NOT NULL DEFAULT 0,
    previous_term_end TEXT
);

CREATE INDEX loan_change_account ON loan_change(account_id, date);

upsertLoan:
INSERT INTO loan(account_id, principal_minor, annual_rate, rate_type, compounding, amortization_months,
    frequency, first_payment_date, payment_minor, extra_payment_minor, term_end, renewal_remind_days,
    property_tax_minor, insurance_minor, payment_account_id, last_paid_date, notes) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
ON CONFLICT(account_id) DO UPDATE SET principal_minor = excluded.principal_minor, annual_rate = excluded.annual_rate, rate_type = excluded.rate_type, compounding = excluded.compounding, amortization_months = excluded.amortization_months, frequency = excluded.frequency, first_payment_date = excluded.first_payment_date, payment_minor = excluded.payment_minor, extra_payment_minor = excluded.extra_payment_minor, term_end = excluded.term_end, renewal_remind_days = excluded.renewal_remind_days, property_tax_minor = excluded.property_tax_minor, insurance_minor = excluded.insurance_minor, payment_account_id = excluded.payment_account_id, last_paid_date = excluded.last_paid_date, notes = excluded.notes;

loan:
SELECT * FROM loan WHERE account_id = ?;

loans:
SELECT * FROM loan;

setLastPaid:
UPDATE loan SET last_paid_date = ? WHERE account_id = ?;

setTermEnd:
UPDATE loan SET term_end = ? WHERE account_id = ?;

deleteLoan:
DELETE FROM loan WHERE account_id = ?;

insertLoanChange:
INSERT INTO loan_change(id, account_id, date, kind, amount_minor, annual_rate, recalculate, txn_id, notes, created_at, renewal, previous_term_end)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

loanChanges:
SELECT * FROM loan_change WHERE account_id = ? ORDER BY date, created_at;

deleteLoanChange:
DELETE FROM loan_change WHERE id = ?;
